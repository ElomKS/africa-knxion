<%- include('../partials/head') %>

<section class="page-head">
  <div class="container">
    <a href="/requests" class="link">&larr; Back to requests</a>
    <h1><%= request.title %></h1>
    <p><span class="card-tag card-tag-request"><%= request.category || 'General' %></span>
       <span class="status status-<%= request.status %>"><%= request.status.charAt(0).toUpperCase() + request.status.slice(1) %></span></p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="profile-layout">
      <div class="profile-main">
        <div class="panel">
          <h2>Details</h2>
          <p><%= request.description %></p>
<% if (request.city || request.state || request.zip) { %>
            <p class="muted">&#128205; <%= formatLocation(request) %></p>
          <% } %>
          <% if (request.professional_name) { %>
            <p class="muted">Professional: <a href="/profiles/<%= request.professional_id %>"><%= request.professional_name %></a></p>
          <% } %>
        </div>

        <% if (user && (user.role === 'admin' || request.user_id === user.id)) { %>
          <div class="panel">
            <h2>Update status</h2>
            <form action="/requests/<%= request.id %>/status" method="POST" class="stack-form">
              <label for="status">Status</label>
              <select id="status" name="status">
                <option value="open" <%= request.status === 'open' ? 'selected' : '' %>>Open</option>
                <option value="assigned" <%= request.status === 'assigned' ? 'selected' : '' %>>Assigned</option>
                <option value="completed" <%= request.status === 'completed' ? 'selected' : '' %>>Completed</option>
              </select>
              <label for="professional_id">Assign a professional</label>
              <select id="professional_id" name="professional_id">
                <option value="">-- None --</option>
                <% professionals.forEach(function (p) { %>
                  <option value="<%= p.id %>" <%= request.professional_id === p.id ? 'selected' : '' %>><%= p.full_name %> (<%= p.profession || 'Member' %>)</option>
                <% }) %>
              </select>
              <button type="submit" class="btn btn-primary">Save</button>
            </form>
          </div>
        <% } %>
      </div>
      <aside class="profile-side">
        <div class="panel">
          <h3>Requested by</h3>
          <a class="list-item provider-box" href="/profiles/<%= request.user_id %>">
            <span class="avatar avatar-lg"><%= request.full_name.charAt(0) %></span>
            <div>
              <strong><%= request.full_name %></strong>
              <span class="muted"><%= request.profession || 'Member' %></span>
            </div>
          </a>
          <div class="profile-contact-stack">
            <% if (request.phone) { %>
              <p><strong>Phone:</strong> <a href="tel:<%= request.phone %>"><%= request.phone %></a></p>
            <% } %>
            <% if (request.email) { %>
              <p><strong>Email:</strong> <a href="mailto:<%= request.email %>"><%= request.email %></a></p>
            <% } %>
          </div>
          <% if (user && user.role === 'admin') { %>
            <a class="btn btn-danger" href="/requests/<%= request.id %>/delete">Delete request</a>
          <% } %>
        </div>
      </aside>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>


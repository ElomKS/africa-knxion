<%- include('../partials/head') %>

<section class="page-head">
  <div class="container">
    <h1>Ask for a service</h1>
    <p>Describe what you need â€” professionals in the community can respond.</p>
  </div>
</section>

<section class="section">
  <div class="container container-narrow">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <form action="/requests" method="POST" class="card form-card">
      <div class="form-group">
        <label for="title">Title *</label>
        <input type="text" id="title" name="title" required placeholder="e.g. I need a plumber for a leaking bathroom">
      </div>
      <div class="form-group">
        <label for="description">Description *</label>
        <textarea id="description" name="description" rows="5" required placeholder="Describe what you need, when, and where&hellip;"></textarea>
      </div>
<div class="form-group">
        <label for="category">Category</label>
        <input type="text" id="category" name="category" placeholder="e.g. Plumbing, Design, IT, Fashion">
      </div>
      <div class="location-block">
        <%- include('../partials/location-fields', { value: { city: '', state: '', zip: '' } }) %>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Post request</button>
        <a href="/requests" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>


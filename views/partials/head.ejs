<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Africa KNXION</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <header class="site-header">
    <div class="pa-strip" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container header-inner">
      <a href="/" class="brand">
        <span class="brand-mark">&#97;&#107;</span>
        <span class="brand-name">Africa <em>KNXION</em></span>
      </a>
      <nav class="main-nav">
        <a href="/" class="<%= path === '/' ? 'active' : '' %>">Home</a>
        <a href="/services" class="<%= path.startsWith('/services') ? 'active' : '' %>">Services</a>
        <a href="/requests" class="<%= path.startsWith('/requests') ? 'active' : '' %>">Requests</a>
        <a href="/directory" class="<%= path.startsWith('/directory') ? 'active' : '' %>">Directory</a>
        <a href="/about" class="<%= path === '/about' ? 'active' : '' %>">About</a>
        <a href="/pricing" class="<%= path === '/pricing' ? 'active' : '' %>">PRO</a>
        <a href="/contact" class="<%= path === '/contact' ? 'active' : '' %>">Contact</a>
      </nav>
      <div class="header-actions">
        <% if (user) { %>
          <a href="/notifications" class="nav-icon-link" title="Notifications">
            &#128276;
            <% if (unreadNotifications > 0) { %><span class="badge badge-nav"><%= unreadNotifications %></span><% } %>
          </a>
          <a href="/messages" class="nav-icon-link" title="Messages">
            &#128172;
            <% if (unreadMessages > 0) { %><span class="badge badge-nav"><%= unreadMessages %></span><% } %>
          </a>
          <a href="/account" class="btn btn-ghost">Account</a>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="btn btn-ghost">Admin</a>
          <% } %>
          <form action="/auth/logout" method="POST" class="inline-form">
            <button class="btn btn-outline" type="submit">Logout</button>
          </form>
        <% } else { %>
          <a href="/auth/login" class="btn btn-ghost">Login</a>
          <a href="/auth/register" class="btn btn-primary">Join free</a>
        <% } %>
      </div>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">&#9776;</button>
    </div>
  </header>
  <main class="site-main">

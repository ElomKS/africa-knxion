<!-- Location fields: city, US state, ZIP code. Expects `value` object with city/state/zip and global `states`. -->
<div class="form-group">
  <label for="city">City</label>
  <input type="text" id="city" name="city" value="<%= value && value.city ? value.city : '' %>" placeholder="e.g. Atlanta">
</div>
<div class="form-group">
  <label for="state">US State</label>
  <select id="state" name="state">
    <option value="">-- Select a state --</option>
    <% states.forEach(function (s) { %>
      <option value="<%= s.code %>" <%= value && (value.state === s.code || value.state === s.name) ? 'selected' : '' %>><%= s.name %></option>
    <% }) %>
  </select>
</div>
<div class="form-group">
  <label for="zip">ZIP Code</label>
  <input type="text" id="zip" name="zip" value="<%= value && value.zip ? value.zip : '' %>" placeholder="e.g. 30301" inputmode="numeric" maxlength="10">
</div>
<%- include('../partials/head') %>

<section class="page-head">
  <div class="container">
    <h1>Reset your password</h1>
    <p>Enter your username and account email and we'll send you a secure reset link.</p>
  </div>
</section>

<section class="section">
  <div class="container container-narrow">
    <% if (sent) { %>
      <div class="alert alert-success">
        <strong>Reset link sent.</strong> If an account matches <strong><%= requestedEmail %></strong>, you will receive an email with a link to set a new password. The link expires in <strong>10 minutes</strong>.
      </div>
      <p class="muted">Didn't receive it? Check your spam folder, or <a href="/auth/forgot">try again</a>.</p>
      <a href="/auth/login" class="btn btn-primary">Back to login</a>
    <% } else { %>
      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <form action="/auth/forgot" method="POST" class="card form-card">
        <div class="form-group">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" required>
        </div>
        <div class="form-group">
          <label for="email">Account email</label>
          <input type="email" id="email" name="email" value="<%= requestedEmail %>" required>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Send reset link</button>
        </div>
        <p class="muted center"><a href="/auth/login">Back to login</a></p>
      </form>
    <% } %>
  </div>
</section>

<%- include('../partials/footer') %>
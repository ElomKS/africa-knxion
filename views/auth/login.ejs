<%- include('../partials/head') %>

<section class="page-head">
  <div class="container">
    <h1>Login</h1>
    <p>Welcome back to Africa KNXION.</p>
  </div>
</section>

<section class="section">
  <div class="container container-narrow">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <form action="/auth/login" method="POST" class="card form-card">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" required>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required>
      </div>
<div class="form-actions">
        <button type="submit" class="btn btn-primary">Login</button>
      </div>
      <p class="muted center"><a href="/auth/forgot">Forgot password?</a></p>
      <p class="muted center">New here? <a href="/auth/register">Create a free account</a></p>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>


<%- include('../partials/head') %>

<section class="page-head">
  <div class="container">
    <h1>Join Africa KNXION</h1>
    <p>Register with your name, contact and profession to connect with the community.</p>
  </div>
</section>

<section class="section">
  <div class="container container-narrow">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <form action="/auth/register" method="POST" class="card form-card">
      <h3>Your details</h3>
      <div class="form-group">
        <label for="full_name">Full name *</label>
        <input type="text" id="full_name" name="full_name" required placeholder="e.g. Awa Diallo">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="you@example.com">
        </div>
        <div class="form-group">
          <label for="phone">Phone</label>
          <input type="text" id="phone" name="phone" placeholder="e.g. +221 77 123 45 67">
        </div>
      </div>
      <div class="form-group">
        <label for="profession">Profession</label>
        <input type="text" id="profession" name="profession" placeholder="e.g. Plumber, Developer, Boutique owner">
      </div>
      <div class="location-block">
        <%- include('../partials/location-fields', { value: { city: '', state: '', zip: '' } }) %>
      </div>
      <div class="form-group">
        <label for="bio">Short bio</label>
        <textarea id="bio" name="bio" rows="3" placeholder="A few words about you and what you offer&hellip;"></textarea>
      </div>

      <h3>Account</h3>
      <div class="form-row">
        <div class="form-group">
          <label for="username">Username *</label>
          <input type="text" id="username" name="username" required placeholder="Choose a username">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="password">Password *</label>
          <input type="password" id="password" name="password" required minlength="6">
        </div>
        <div class="form-group">
          <label for="password_confirm">Confirm password *</label>
          <input type="password" id="password_confirm" name="password_confirm" required minlength="6">
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create account</button>
      </div>
      <p class="muted center">Already have an account? <a href="/auth/login">Login</a></p>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>


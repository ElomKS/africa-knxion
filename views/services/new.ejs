<%- include('../partials/head') %>

<section class="page-head">
  <div class="container">
    <h1>Publish a service offer</h1>
    <p>Tell the community what you can do.</p>
  </div>
</section>

<section class="section">
  <div class="container container-narrow">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <form action="/services" method="POST" class="card form-card">
      <div class="form-group">
        <label for="title">Title *</label>
        <input type="text" id="title" name="title" required placeholder="e.g. Home plumbing repairs">
      </div>
      <div class="form-group">
        <label for="description">Description *</label>
        <textarea id="description" name="description" rows="5" required placeholder="Describe the service you provide, experience, availability&hellip;"></textarea>
      </div>
<div class="form-group">
        <label for="category">Category</label>
        <input type="text" id="category" name="category" placeholder="e.g. Plumbing, Design, IT, Fashion">
      </div>
      <div class="location-block">
        <%- include('../partials/location-fields', { value: { city: '', state: '', zip: '' } }) %>
      </div>
      <div class="form-group">
        <label for="price">Price / Rates</label>
        <input type="text" id="price" name="price" placeholder="e.g. From $120 or Negotiable">
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Publish offer</button>
        <a href="/services" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>
</section>

<%- include('../partials/footer') %>

